{% extends 'base.html.twig' %}

{% block title %}Listes des artistes{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <table border="1">
        <thead>
            <tr>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for artist in artists %}
                <tr>
                    <td>{{ artist.firstname }}</td>
                    <td>{{ artist.lastname }}</td>
                    <td>
                        <a href="{{ path('app_artist_show', {id: artist.id}) }}">Afficher</a>
                        {{ include('artist/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <nav>
        <a href="{{ path('artist_new')}}">Ajouter</a>
    </nav>
{% endblock %}
